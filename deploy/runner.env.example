XLLOOP_RUNNER_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Add only credentials explicitly allowed by runner-config.json.
# OpenAI credentials stay server-side and are passed only to approved adapters.
# OPENAI_API_KEY=replace-through-a-secure-channel
# OPENAI_MODEL=gpt-6-astra
# Set current model prices from the official pricing page before enabling calls.
# OPENAI_INPUT_USD_PER_1M=
# OPENAI_OUTPUT_USD_PER_1M=
# OPENAI_CACHED_INPUT_USD_PER_1M=
# OPENAI_TIMEOUT_SECONDS=120
# XLLOOP_ANALYTICS_FILE=/srv/xlloop/analytics/ybirds.json
# GITLAB_TOKEN=replace-through-a-secure-channel
