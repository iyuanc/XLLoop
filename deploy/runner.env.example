XLLOOP_RUNNER_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Add only credentials explicitly allowed by runner-config.json.
# GITLAB_TOKEN=replace-through-a-secure-channel
# Git provisioning and operator-approved xlloop/* branch publishing use a
# server-side read-write deploy key or service-account key plus pinned hosts.
# GIT_SSH_COMMAND="/usr/bin/ssh -i /etc/xlloop/gitlab_deploy_key -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/xlloop/git_known_hosts"

# Claude code/spec/review/retro adapter. Keep the key only on the runner host.
# ANTHROPIC_API_KEY=replace-through-a-secure-channel
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01
SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
HOME=/mnt/data500/xlloop/runtime/runner-home
XDG_CONFIG_HOME=/mnt/data500/xlloop/runtime/runner-home/.config
XDG_DATA_HOME=/mnt/data500/xlloop/runtime/runner-home/.local/share
PNPM_HOME=/mnt/data500/xlloop/runtime/runner-home/.local/share/pnpm
# CLAUDE_TIMEOUT_SECONDS=180
# CLAUDE_MAX_AGENT_STEPS=12
# XLLOOP_BRANCH_PREFIX=xlloop/
# XLLOOP_ALLOWED_BRANCHES=xlloop/ybirds
# XLLOOP_PROTECTED_BRANCHES=main,master,production,release
# XLLOOP_MAX_CHANGED_FILES=20
# XLLOOP_MAX_PATCH_BYTES=100000
# The JSON value is single-quoted for systemd EnvironmentFile parsing.
# XLLOOP_CHECK_COMMANDS_JSON='{"build":["pnpm","build"]}'
# For a single-repository project, the fixed CI adapter uses this list.
# Multi-repository projects use each repository's checks selected in the UI.
# XLLOOP_REQUIRED_TEST_CHECKS=build
# Set a model and current official prices for each task. Generic CLAUDE_* values
# are fallbacks; task-specific values such as CLAUDE_DEVELOP_MODEL take priority.
# CLAUDE_MODEL=
# CLAUDE_INPUT_USD_PER_1M=
# CLAUDE_OUTPUT_USD_PER_1M=
# CLAUDE_CACHE_READ_USD_PER_1M=
# CLAUDE_CACHE_WRITE_USD_PER_1M=
# CLAUDE_MAX_OUTPUT_TOKENS=4096
# CLAUDE_SPEC_MODEL=
# CLAUDE_DEVELOP_MODEL=
# CLAUDE_REVIEW_MODEL=
# CLAUDE_RETRO_MODEL=
