NODE_ENV=production

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=xlloop
MYSQL_USER=xlloop_app
MYSQL_PASSWORD=replace-through-a-secure-channel
MYSQL_CONNECTION_LIMIT=10

XLLOOP_OWNER_EMAIL=owner@example.com
XLLOOP_SESSION_HOURS=8
XLLOOP_SERVICE_KEY=replace-with-a-random-secret-of-at-least-32-characters
XLLOOP_RUNNER_URL=http://127.0.0.1:8788
XLLOOP_RUNNER_TOKEN=replace-with-the-same-random-runner-token
XLLOOP_FEEDBACK_BRIDGE_KEY=replace-if-the-wecom-bridge-is-enabled
